# Copy to .env (or set in your host's dashboard). Never commit real secrets.

PORT=3000
# Public HTTPS address of the site. Bank of Georgia requires an HTTPS callback URL.
BASE_URL=http://localhost:3000

# "mock" = built-in test checkout, no real money. "bog" = Bank of Georgia Payment Manager.
PAYMENT_PROVIDER=mock

# Bank of Georgia credentials (from the bank after merchant onboarding, or sandbox credentials)
BOG_CLIENT_ID=
BOG_CLIENT_SECRET=

# First admin account, created on first run if no admin exists
ADMIN_EMAIL=admin@donori.ge
ADMIN_PASSWORD=change-me-now

# Platform fee in percent kept by the nonprofit (0 = none, donors cover nothing extra)
PLATFORM_FEE_PERCENT=0
